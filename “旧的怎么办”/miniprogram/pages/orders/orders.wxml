<view class="page sticky-safe">
  <view wx:if="{{!loggedIn}}" class="card">
    <view class="section-title">订单中心</view>
    <view class="section-subtitle">登录后查看待支付、待发货、待收货和已完成订单。</view>
    <button class="btn-primary btn-block" style="margin-top: 20rpx;" bindtap="goLogin">去登录</button>
  </view>

  <block wx:else>
    <view class="card">
      <view class="section-head">
        <view>
          <view class="section-title">订单状态</view>
          <view class="section-subtitle">支付后等待卖家发货，发货后买家确认收货</view>
        </view>
      </view>
      <scroll-view scroll-x class="chip-row category-scroll">
        <view
          wx:for="{{statusTabs}}"
          wx:key="value"
          class="chip {{currentStatus === item.value ? 'active' : ''}}"
          data-status="{{item.value}}"
          bindtap="onStatusTap"
        >
          {{item.label}}
        </view>
      </scroll-view>
    </view>

    <view class="card">
      <view class="section-head">
        <view>
          <view class="section-title">订单列表</view>
          <view class="section-subtitle">共 {{orders.length}} 笔订单</view>
        </view>
        <button class="btn-secondary" bindtap="loadOrders">刷新</button>
      </view>

      <view wx:if="{{orders.length}}" class="list-stack">
        <view wx:for="{{orders}}" wx:key="id" class="order-card">
          <view class="order-card-header">
            <view>
              <view class="section-title" style="font-size: 28rpx;">{{item.itemTitle || '校园商品'}}</view>
              <view class="section-subtitle">{{item.roleText}} · 订单号 {{item.orderNo}}</view>
            </view>
            <view class="status-tag">{{item.statusText}}</view>
          </view>
          <view class="muted">买家：{{item.buyerName || '-'}} · 卖家：{{item.sellerName || '-'}}</view>
          <view class="muted">收货人：{{item.receiverName || '-'}} · {{item.receiverPhone || '-'}}</view>
          <view class="muted">地址：{{item.receiverCampus || '-'}} {{item.receiverDetail || ''}}</view>
          <view class="muted">支付方式：{{item.paymentMethodText}}</view>
          <view class="muted">创建时间：{{item.createdAtText}}</view>
          <view wx:if="{{item.paymentCountdownText}}" class="muted">{{item.paymentCountdownText}}</view>
          <view class="price-row">
            <view class="price">￥{{item.amount}}</view>
          </view>
          <view class="goods-actions">
            <button wx:if="{{item.canPay}}" class="mini-solid mini-compact" bindtap="payOrder" data-id="{{item.id}}">去支付</button>
            <button wx:if="{{item.canCancel}}" class="mini-outline mini-compact" bindtap="cancelOrder" data-id="{{item.id}}">取消订单</button>
            <button wx:if="{{item.canShip}}" class="mini-solid mini-compact" bindtap="shipOrder" data-id="{{item.id}}">确认发货</button>
            <button wx:if="{{item.canComplete}}" class="mini-solid mini-compact" bindtap="completeOrder" data-id="{{item.id}}">确认收货</button>
            <button wx:if="{{item.canHide}}" class="mini-outline mini-compact" bindtap="hideOrder" data-id="{{item.id}}">隐藏记录</button>
          </view>
        </view>
      </view>

      <view wx:else class="empty-box">当前状态下没有订单。</view>
    </view>
  </block>
</view>
