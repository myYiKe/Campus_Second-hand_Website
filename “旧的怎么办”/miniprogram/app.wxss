page {
  background: #f5f7fb;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 1.6;
}

view,
text,
button,
input,
textarea,
scroll-view,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: inherit;
  border: 0;
  background: transparent;
}

button::after {
  border: 0;
}

.page {
  padding: 24rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
}

.hero-card {
  background: linear-gradient(135deg, #d9232e, #f97316);
  color: #ffffff;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.hero-card .section-subtitle {
  color: rgba(255, 255, 255, 0.82);
}

.muted {
  color: #6b7280;
}

.danger {
  color: #d9232e;
}

.success {
  color: #059669;
}

.warning {
  color: #d97706;
}

.empty-box {
  padding: 36rpx 24rpx;
  border: 2rpx dashed #d1d5db;
  border-radius: 22rpx;
  text-align: center;
  color: #6b7280;
  background: #f9fafb;
}

.chip-row,
.button-row,
.inline-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #374151;
  font-size: 24rpx;
}

.chip.active {
  background: #fee2e2;
  color: #d9232e;
}

.tag,
.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.tag {
  background: rgba(255, 255, 255, 0.92);
  color: #d9232e;
}

.status-tag {
  background: #eff6ff;
  color: #2563eb;
}

.status-warn {
  background: #fff7ed;
  color: #d97706;
}

.status-success {
  background: #ecfdf5;
  color: #059669;
}

.btn-primary,
.btn-secondary,
.btn-light,
.btn-danger,
.mini-outline,
.mini-danger,
.mini-solid {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.btn-primary,
.mini-solid {
  background: #d9232e;
  color: #ffffff;
}

.btn-secondary,
.mini-outline {
  background: #ffffff;
  color: #d9232e;
  border: 2rpx solid #fecaca;
}

.btn-light {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.24);
}

.btn-danger,
.mini-danger {
  background: #fee2e2;
  color: #d9232e;
}

.btn-block {
  width: 100%;
}

.search-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.search-row .field-input {
  flex: 1;
  min-width: 0;
}

.search-row .btn-light,
.search-row .btn-primary,
.search-row .btn-secondary {
  flex-shrink: 0;
}

.form-grid {
  display: grid;
  gap: 20rpx;
}

.field-block {
  display: grid;
  gap: 10rpx;
}

.field-label {
  color: #374151;
  font-size: 24rpx;
  font-weight: 700;
}

.field-input,
.field-picker {
  width: 100%;
  height: 72rpx;
  padding: 0 22rpx;
  line-height: 72rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 20rpx;
  background: #ffffff;
  font-size: 22rpx;
}

.field-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 20rpx;
  background: #ffffff;
  font-size: 22rpx;
  line-height: 1.6;
}

.input-placeholder {
  color: #9ca3af;
  font-size: 18rpx;
  line-height: 72rpx;
}

.textarea-placeholder {
  color: #9ca3af;
  font-size: 18rpx;
  line-height: 1.6;
}

.quick-grid,
.panel-grid,
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.quick-card,
.stat-card,
.panel-card {
  padding: 20rpx;
  border-radius: 22rpx;
  background: #fff7ed;
}

.stat-card {
  background: linear-gradient(180deg, #fff7ed, #ffffff);
}

.stat-value {
  display: block;
  margin-top: 10rpx;
  color: #d9232e;
  font-size: 40rpx;
  font-weight: 800;
}

.goods-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.goods-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.goods-cover {
  position: relative;
  height: 220rpx;
  background: linear-gradient(135deg, #fee2e2, #fff7ed);
}

.goods-image,
.cover-image,
.upload-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.goods-cover .tag,
.goods-cover .status-tag {
  position: absolute;
  top: 16rpx;
}

.goods-cover .tag {
  left: 16rpx;
}

.goods-cover .status-tag {
  right: 16rpx;
}

.goods-placeholder {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
}

.goods-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 18rpx;
}

.goods-title {
  min-height: 76rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.goods-desc {
  min-height: 68rpx;
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.goods-meta {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 23rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.goods-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
  width: 100%;
}

.price {
  color: #d9232e;
  font-size: 34rpx;
  font-weight: 800;
}

.mini-compact {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 60rpx;
  padding: 0 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 22rpx;
}

.list-stack,
.message-list,
.chat-area {
  display: grid;
  gap: 18rpx;
}

.list-card,
.order-card,
.message-card,
.record-card {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f8fafc;
}

.order-card-header,
.record-head,
.user-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.gallery-strip {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.gallery-thumb {
  width: 120rpx;
  height: 120rpx;
  overflow: hidden;
  border: 4rpx solid transparent;
  border-radius: 18rpx;
}

.gallery-thumb.active {
  border-color: #d9232e;
}

.profile-hero {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.avatar-circle {
  display: flex;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: linear-gradient(135deg, #d9232e, #fb7185);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
}

.avatar-circle image {
  width: 100%;
  height: 100%;
}

.upload-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.upload-card {
  overflow: hidden;
  border-radius: 18rpx;
  background: #f8fafc;
}

.upload-thumb {
  height: 180rpx;
}

.upload-actions {
  padding: 12rpx;
}

.message-item {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f8fafc;
}

.message-item.active {
  background: #fee2e2;
}

.chat-bubble {
  max-width: 85%;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  word-break: break-all;
}

.chat-bubble.self {
  margin-left: auto;
  background: #d9232e;
  color: #ffffff;
}

.chat-bubble.other {
  background: #ffffff;
}

.chat-bubble.system {
  max-width: 100%;
  background: #fff7ed;
  color: #9a3412;
}

.sticky-safe {
  padding-bottom: 24rpx;
}
